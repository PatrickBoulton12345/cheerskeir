# Cheers Keir — environment variables
# Copy to .env.local for local dev (vercel dev), and set the same values in
# Vercel → Project → Settings → Environment Variables for Production/Preview.

# --- Brevo (LFG account) ---
# Server-side only. Never commit the real key.
BREVO_API_KEY=xkeysib-REPLACE_ME
# Numeric ID of the general newsletter list. Find it in Brevo → Contacts → Lists.
BREVO_LIST_ID=123

# --- Cloudflare Turnstile ---
# Get both from Cloudflare → Turnstile → Add site.
# The SITE key is public (also inlined in index.html). The SECRET key is server-side only.
TURNSTILE_SITE_KEY=0x4AAAAAAA_SITE_KEY_HERE
TURNSTILE_SECRET_KEY=0x4AAAAAAA_SECRET_KEY_HERE
